# Copy to .env (never commit .env). Real environment variables take precedence over this file.

# Required for Grok bots. Create a key at https://console.x.ai
XAI_API_KEY=

# Optional
# PORT=3000
# HOST=127.0.0.1                 # keep loopback unless you know what you're doing
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_TIMEOUT_MS=45000
# XAI_MAX_REQUESTS_PER_MINUTE=20 # server-side cap across all bots
# XAI_MAX_REQUESTS_PER_HOUR=300
